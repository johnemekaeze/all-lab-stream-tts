# Paste into Streamlit Community Cloud → App settings → Secrets.
# Do not commit a real secrets.toml file.
#
# HF_TOKEN is required for the live Hugging Face endpoint.

HF_TOKEN = "hf_your_token_here"
INDIVIDUAL_ENDPOINT = "https://your-individual-endpoint"
COMBINED_ENDPOINT = "mock"
MOCK_MODE = false
RANDOMIZE_AB = false
SAMPLE_A_SYSTEM = "individual"
TESTER_ID_MODE = "required"
ADMIN_PASSWORD = "choose-a-strong-password"
REQUEST_TIMEOUT = 120
MAX_RETRIES = 2
