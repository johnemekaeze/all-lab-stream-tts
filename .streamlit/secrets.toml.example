# Paste into Streamlit Community Cloud → App settings → Secrets.
# Do not commit a real secrets.toml file. Your local .env stays off GitHub.
#
# HF_TOKEN is required. Without it every system stays on placeholder audio.

HF_TOKEN = "hf_your_token_here"
INDIVIDUAL_ENDPOINT = "https://your-individual-endpoint"
COMBINED_ENDPOINT = "mock"
MOCK_MODE = false
RANDOMIZE_AB = false
SAMPLE_A_SYSTEM = "individual"
TESTER_ID_MODE = "required"
ADMIN_PASSWORD = "choose-a-strong-password"
REQUEST_TIMEOUT = 120
MAX_RETRIES = 2
ENABLE_RANDOM_MODE = true
DEFAULT_SELECTION_MODE = "researcher"
RESULTS_DB = "results/evaluations.db"
AUDIO_CACHE_DIR = "data/audio_cache"
LOG_FILE = "data/app.log"
LOG_LEVEL = "INFO"
