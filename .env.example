# ---------------------------------------------------------------------------
# Template. Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Hugging Face token ----------------------------------------------------
# Needs access to the organisation that owns the Inference Endpoint(s).
HF_TOKEN=your_huggingface_token

# --- The two systems under test -------------------------------------------
# Each variable takes either:
#   an inference URL   -> that system calls the real endpoint
#   the literal "mock" -> that system serves placeholder audio (not deployed
#                         yet). Its result rows are flagged with mock_mode=1.
#   empty              -> same as "mock"
INDIVIDUAL_ENDPOINT=https://your-individual-endpoint
COMBINED_ENDPOINT=https://your-combined-endpoint

# Global override: true forces BOTH systems to the offline mock, so the whole
# UI can be exercised with no Hugging Face calls at all.
MOCK_MODE=true

# --- A/B mapping -----------------------------------------------------------
# true (default) = the mapping is drawn per trial, which is what the study
# needs. false pins it, which is only sensible while one system is still a
# placeholder; every row records which of the two applied (`ab_randomized`).
RANDOMIZE_AB=true
SAMPLE_A_SYSTEM=individual

# --- Endpoint behaviour ----------------------------------------------------
# Seconds to wait for a single synthesis request.
REQUEST_TIMEOUT=120
# Retries per endpoint (useful when a scale-to-zero endpoint is warming up).
MAX_RETRIES=2

# --- Tester identity -------------------------------------------------------
# required -> the tester must type their name before samples load (default)
# prompt   -> pre-filled anonymous ID that the tester may replace
# auto     -> anonymous generated ID, not editable
TESTER_ID_MODE=required

# --- Test selection --------------------------------------------------------
# Show the "Randomised" test-selection mode in the sidebar.
ENABLE_RANDOM_MODE=true
# Default selection mode: researcher | random
DEFAULT_SELECTION_MODE=researcher

# --- Researcher / admin dashboard -----------------------------------------
# Leave empty to hide the researcher dashboard completely.
ADMIN_PASSWORD=

# --- Storage paths (relative paths are resolved from the project root) -----
RESULTS_DB=results/evaluations.db
AUDIO_CACHE_DIR=data/audio_cache
LOG_FILE=data/app.log
LOG_LEVEL=INFO
